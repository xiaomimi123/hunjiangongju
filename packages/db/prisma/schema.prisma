generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  nickname     String?
  account      String?  @map("account")
  passwordHash String   @map("password_hash")
  role         String   @default("student")
  disabled     Boolean  @default(false)
  // 积分（仅学员扣减）：1 条视频 = 1 积分；新账号默认送 30；
  // 用完由导师在后台充值（流水见 CreditLog），删任务不返还。
  credits      Int      @default(30)
  /// 会话代次。改密码时 +1，使该用户所有已签发的 token 立即失效（JWT 无状态，靠比对这个数收口）
  sessionEpoch Int      @default(0) @map("session_epoch")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

// 积分充值流水：只记后台加分（reason='recharge'），消耗可从生成任务反查，不逐条记流水
model CreditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  delta      Int
  reason     String
  operatorId String?  @map("operator_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("credit_logs")
}

// 站点级配置单例（id 恒为 1）：目前只有导师收款二维码
model SiteConfig {
  id            Int      @id @default(1)
  rechargeQrUrl String   @default("") @map("recharge_qr_url")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("site_config")
}

model SmtpConfig {
  id          Int      @id @default(1)
  host        String   @default("")
  port        Int      @default(465)
  secure      Boolean  @default(true)
  username    String   @default("")
  passwordEnc String   @default("") @map("password_enc")
  fromAddress String   @default("") @map("from_address")
  fromName    String   @default("东方文澜") @map("from_name")
  enabled     Boolean  @default(false)
  registrationOpen Boolean @default(false) @map("registration_open")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("smtp_config")
}

model EmailCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    @map("code_hash")
  purpose    String
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("email_codes")
}

model SourceVideo {
  id             String          @id @default(uuid())
  douyinShareUrl String          @map("douyin_share_url")
  videoFileUrl   String?         @map("video_file_url")
  status         String          @default("CREATED")
  createdBy      String?         @map("created_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  transcripts    Transcript[]
  sceneCuts      SceneCut[]
  frameworks     CopyFramework[]
  @@map("source_videos")
}

model Transcript {
  id            String      @id @default(uuid())
  sourceVideoId String      @map("source_video_id")
  source        SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  fullText      String      @map("full_text")
  sentences     Json?
  createdAt     DateTime    @default(now()) @map("created_at")
  @@map("transcripts")
}

model SceneCut {
  id            String      @id @default(uuid())
  sourceVideoId String      @map("source_video_id")
  source        SourceVideo @relation(fields: [sourceVideoId], references: [id], onDelete: Cascade)
  cutPointsMs   Int[]       @map("cut_points_ms")
  @@map("scene_cuts")
}

model CopyFramework {
  id                    String           @id @default(uuid())
  sourceVideoId         String?          @map("source_video_id")
  source                SourceVideo?     @relation(fields: [sourceVideoId], references: [id])
  name                  String?
  industryCategory      String?          @map("industry_category")
  visualStyleType       String           @default("ai_illustration") @map("visual_style_type")
  renderTemplate        String?          @map("render_template")
  overlayTemplate       Json?            @map("overlay_template")
  frameworkText         String           @map("framework_text")
  suggestedSegmentCount Int?             @map("suggested_segment_count")
  maxLines              Int?             @map("max_lines")
  maxTotalChars         Int?             @map("max_total_chars")
  imageStylePrompt      String?          @map("image_style_prompt")
  // 拆解降级警告：ASR/vision 走 mock 时置提示，内容不可信；正常为 null。防止"静默造假框架"。
  degradedNote          String?          @map("degraded_note")
  // 剪映草稿保真度报告：仅在从剪映工程导入/保存时写入一次(导入时快照)，不随后续编辑更新；
  // 老框架/非剪映来源框架为 null。结构见 packages/db/src/booklist/draftProvenance.ts。
  draftFidelityReport   Json?            @map("draft_fidelity_report")
  published             Boolean          @default(false)
  createdBy             String?          @map("created_by")
  createdAt             DateTime         @default(now()) @map("created_at")
  generationTasks       GenerationTask[]
  @@map("copy_frameworks")
}

model GenerationTask {
  id           String             @id @default(uuid())
  frameworkId  String             @map("framework_id")
  framework    CopyFramework      @relation(fields: [frameworkId], references: [id])
  subject      String
  variables    Json?
  fullAudioUrl String?            @map("full_audio_url")
  bodyTimings  Json?              @map("body_timings")
  status       String             @default("GEN_CREATED")
  published    Boolean            @default(false)
  autoRender   Boolean            @default(false) @map("auto_render")
  createdBy    String?            @map("created_by")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  segments     GeneratedSegment[]
  renderTasks  RenderTask[]
  @@map("generation_tasks")
}

model GeneratedSegment {
  id               String         @id @default(uuid())
  generationTaskId String         @map("generation_task_id")
  task             GenerationTask @relation(fields: [generationTaskId], references: [id], onDelete: Cascade)
  seqNo            Int            @map("seq_no")
  scriptText       String         @map("script_text")
  imageUrl         String?        @map("image_url")
  bookTitle        String?        @map("book_title")
  bookAuthor       String?        @map("book_author")
  subtitleEn       String?        @map("subtitle_en")
  // 字幕节拍：把本段口播拆成短句 [{zh, en}]，渲染时在本段时间窗内快速逐拍切换（图片保持不动）。
  // 缺省(旧任务)则回退整段单条字幕。
  captionBeats     Json?          @map("caption_beats")
  @@map("generated_segments")
}

model BgmLibrary {
  id          String       @id @default(uuid())
  fileUrl     String       @map("file_url")
  styleTag    String?      @map("style_tag")
  durationMs  Int?         @map("duration_ms")
  name        String?
  folder      String?
  renderTasks RenderTask[]
  @@map("bgm_library")
}

model RenderTask {
  id               String            @id @default(uuid())
  generationTaskId String            @map("generation_task_id")
  task             GenerationTask    @relation(fields: [generationTaskId], references: [id], onDelete: Cascade)
  bgmId            String?           @map("bgm_id")
  bgm              BgmLibrary?       @relation(fields: [bgmId], references: [id])
  status           String            @default("RENDERING")
  videoUrl         String?           @map("video_url")
  subtitleUrl      String?           @map("subtitle_url")
  createdAt        DateTime          @default(now()) @map("created_at")
  statusLogs       RenderStatusLog[]
  qcReports        RenderQcReport[]
  @@map("render_tasks")
}

model RenderStatusLog {
  id           String     @id @default(uuid())
  renderTaskId String     @map("render_task_id")
  task         RenderTask @relation(fields: [renderTaskId], references: [id], onDelete: Cascade)
  fromStatus   String?    @map("from_status")
  toStatus     String     @map("to_status")
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at")
  @@map("render_status_logs")
}

model RenderQcReport {
  id           String     @id @default(uuid())
  renderTaskId String     @map("render_task_id")
  task         RenderTask @relation(fields: [renderTaskId], references: [id], onDelete: Cascade)
  checkType    String     @map("check_type")
  result       String
  detail       String?
  createdAt    DateTime   @default(now()) @map("created_at")
  @@map("render_qc_reports")
}

model ClonedVoice {
  id             String   @id @default(uuid())
  voiceId        String   @unique @map("voice_id")
  name           String
  sampleAssetUrl String   @map("sample_asset_url")
  provider       String   @default("dashscope")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  @@map("cloned_voices")
}

model StockAsset {
  id        String   @id @default(uuid())
  kind      String   // 'image' | 'video'
  name      String
  folder    String?
  fileUrl   String   @map("file_url")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("stock_assets")
}

model AiCapabilityConfig {
  capability String   @id
  baseUrl    String   @default("") @map("base_url")
  apiKeyEnc  String   @default("") @map("api_key_enc")
  model      String   @default("")
  enabled    Boolean  @default(false)
  extra      Json?
  updatedAt  DateTime @updatedAt @map("updated_at")
  @@map("ai_capability_config")
}

/// 运营上传的自定义字体。内置字体见 packages/db/src/booklist/fonts.ts（不入库）。
model CustomFont {
  id        String   @id @default(cuid())
  /// 后台下拉里的显示名，运营填
  label     String
  /// 字体内部族名（name 表 name ID 1），上传时用 fontkit 解析。写进 ASS 的 Fontname
  family    String
  /// 字重，400 或 700。驱动 ASS 样式行的 Bold 位；不存的话上传的粗体字体选了不会加粗
  weight    Int      @default(400)
  /// data/fonts/ 下的文件名
  fileName  String   @map("file_name")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("custom_fonts")
}

model BookLibrary {
  id        String   @id @default(uuid())
  title     String
  author    String
  theme     String?
  points    String?
  source    String   @default("ai")
  // 书封：同一本书的封面只做一次，之后所有片子复用。
  // 原先每条片子都为每本书重生成一张底图——9 本书就是 9 次生图调用，
  // 而书封只跟「这本书」有关、跟这条片子的文案毫无关系。
  coverUrl    String?  @map("cover_url")
  // 'upload'=运营上传的真实封面（与原工程一致，最准）/ 'ai'=按框架画风生成的底图
  coverSource String?  @map("cover_source")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([title, author])
  @@map("book_library")
}

/// 后台导入的扣子工作流工具。学员端「工具广场」按 enabled + sortOrder 展示。
model CozeTool {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  workflowId   String   @map("workflow_id")
  /// [{ name, label, type: 'text'|'textarea'|'select'|'image', options?, placeholder?, required }]
  inputs       Json
  priceCredits Int      @default(1) @map("price_credits")
  enabled      Boolean  @default(false)
  sortOrder    Int      @default(0) @map("sort_order")
  /// 演示视频（成品效果）与教学视频（怎么填参数），后台上传，学员端工具页展示
  demoVideoUrl     String? @map("demo_video_url")
  tutorialVideoUrl String? @map("tutorial_video_url")
  createdAt    DateTime @default(now()) @map("created_at")
  @@map("coze_tools")
}

/// 学员的每次运行。软引用 user/tool（与仓库现有风格一致，应用层校验）。
model CozeToolRun {
  id          String    @id @default(cuid())
  toolId      String    @map("tool_id")
  userId      String    @map("user_id")
  inputs      Json
  status      String    @default("QUEUED")
  outputRaw   Json?     @map("output_raw")
  outputItems Json?     @map("output_items")
  errorMsg    String?   @map("error_msg")
  creditsCost Int       @map("credits_cost")
  refunded    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  finishedAt  DateTime? @map("finished_at")
  @@index([userId, createdAt])
  @@map("coze_tool_runs")
}

/// 移动端首页公告 Banner。学员端只看 enabled 的，按 sortOrder asc 展示。
model Banner {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  linkUrl   String?  @map("link_url")
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("banners")
}
